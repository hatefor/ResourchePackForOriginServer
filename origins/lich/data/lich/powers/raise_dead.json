          "type": "apoli:resource",
          "resource": "lich:soul_harvest_souls",
          "comparison": ">=",
          "compare_to": 2
        },
        {
          "type": "apoli:command",
          "command": "execute if entity @e[tag=lich_minion,distance=..64]",
          "comparison": "<",
          "compare_to": 4
