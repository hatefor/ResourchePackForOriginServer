{
  "type": "apoli:multiple",
  "name": "Undead Physiology",
  "description": "You are undead. Poison, hunger and drowning can't touch you and phantoms never come for you, but you never heal on your own and have 3 fewer hearts. Smite and Instant Health hurt you (Instant Damage heals you), fire burns you harder, and the sun sets you alight unless you wear a helmet.",
  "undead": {
    "type": "apoli:entity_group",
    "group": "undead"
  },
  "immunities": {
    "type": "apoli:effect_immunity",
    "effects": [
      "minecraft:poison",
      "minecraft:hunger"
    ]
  },
  "no_appetite": {
    "type": "apoli:modify_exhaustion",
    "modifier": {
      "name": "Undead need no food",
      "value": -1.0,
      "operation": "multiply_base"
    }
  },
  "sated": {
    "type": "apoli:action_over_time",
    "interval": 200,
    "entity_action": {
      "type": "apoli:feed",
      "food": 20,
      "saturation": 0.0
    }
  },
  "no_breath": {
    "type": "apoli:invulnerability",
    "damage_condition": {
      "type": "apoli:in_tag",
      "tag": "minecraft:is_drowning"
    }
  },
  "no_phantoms": {
    "type": "apoli:modify_insomnia_ticks",
    "modifier": {
      "operation": "set_total",
      "value": 0
    }
  },
  "no_regen": {
    "type": "apoli:disable_regen"
  },
  "frail": {
    "type": "apoli:attribute",
    "modifier": {
      "attribute": "minecraft:generic.max_health",
      "operation": "addition",
      "value": -6.0,
      "name": "Lich frailty"
    }
  },
  "tinder": {
    "type": "apoli:modify_damage_taken",
    "damage_condition": {
      "type": "apoli:fire"
    },
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "value": 0.5
    }
  },
  "sunburn": {
    "type": "apoli:burn",
    "interval": 20,
    "burn_duration": 3,
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "apoli:exposed_to_sun"
        },
        {
          "type": "apoli:equipped_item",
          "equipment_slot": "head",
          "item_condition": {
            "type": "apoli:empty"
          }
        }
      ]
    }
  }
}
