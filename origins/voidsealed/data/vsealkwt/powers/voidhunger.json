{
    "name": "Void's Hunger",
    "description": "Your body isn't well adapted to other dimensions, becoming considerably weaker over time.",
    "type": "apoli:multiple",
    "res": {
        "type": "apoli:resource",
        "min": -300,
        "max": 200,
        "start_value": 0,
        "hud_render": {
            "should_render": true
        }
    },
    "time": {
        "type": "apoli:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "apoli:if_else",
            "condition": {
                "type": "apoli:dimension",
                "dimension": "minecraft:the_end"
            },
            "if_action": {
                "type": "apoli:change_resource",
                "resource": "*:*_res",
                "change": 6
            },
            "else_action": {
                "type": "apoli:change_resource",
                "resource": "*:*_res",
                "change": -1
            }
        }
    },
	"hunger": {
		"type": "apoli:modify_exhaustion",
		"modifier": {
			"operation": "multiply_total",
			"value": 0.3
		},
		"condition": {
			"type": "apoli:dimension",
			"dimension": "minecraft:the_end",
            "inverted": true
		}
	}
}