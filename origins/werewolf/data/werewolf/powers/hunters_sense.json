{
  "type": "apoli:multiple",
  "name": "Hunter's Sense",
  "description": "Human, primary: sniff the air. For 10 seconds every living thing within 32 blocks glows for you, even through walls. Adds 5 rage.",
  "timer": {
    "type": "apoli:resource",
    "min": 0,
    "max": 10,
    "start_value": 0,
    "hud_render": {
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 0,
      "should_render": false
    }
  },
  "sniff": {
