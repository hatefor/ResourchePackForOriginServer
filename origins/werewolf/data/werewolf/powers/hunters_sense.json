        {
          "type": "apoli:change_resource",
          "resource": "werewolf:hunters_sense_timer",
          "change": 10,
          "operation": "set"
        },
        {
          "type": "apoli:change_resource",
          "resource": "werewolf:the_beast_within_rage",
          "change": 5,
          "operation": "add"
        },
        {
          "type": "apoli:play_sound",
          "sound": "minecraft:entity.fox.sniff",
          "volume": 1.0,
          "pitch": 0.7
        },
        {
          "type": "apoli:play_sound",
          "sound": "minecraft:entity.fox.sniff",
          "volume": 1.0,
          "pitch": 0.9
        }
