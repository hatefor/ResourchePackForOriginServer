          "inverted": true
        },
        {
          "type": "apoli:sneaking",
          "inverted": true
        }
      ]
    },
    "cooldown": 600,
    "hud_render": {
      "sprite_location": "origins:textures/gui/resource_bar.png",
      "bar_index": 8
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "entity_action": {
      "type": "apoli:and",
